# ConnectSphere — Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-app-name.onrender.com

# ─── Database (MongoDB Atlas) ─────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/connectsphere?retryWrites=true&w=majority

# ─── Authentication ───────────────────────────────────────────────────
# Use a long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_replace_this_with_a_64_char_random_string

# ─── Cloudinary (Media Storage) ───────────────────────────────────────
# Get this from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Optional ────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key
